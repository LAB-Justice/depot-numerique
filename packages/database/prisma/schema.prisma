// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MailType {
  LR
  LS

  @@map("mail_type")
}

enum DocumentStatus {
  RECEIVED
  STORED
  STORAGE_FAILED
  ANALYZING
  ANALYSIS_FAILED
  NON_COMPLIANT
  EXTRACTING
  LLM_PENDING
  LLM_FAILED
  GENERATING_AFNOR
  CORRECTED
  COMPLIANT
  QUEUED
  SUBMITTING
  SUBMITTED
  SUBMISSION_FAILED
  REJECTED
  PURGED

  @@map("document_status")
}

enum DocumentFileKind {
  ORIGINAL
  EXTRACTED
  GENERATED
  CORRECTED
  SUBMITTED
  REJECTED

  @@map("document_file_kind")
}

enum UserRole {
  ADMINISTRATEUR_GENERAL
  ADMINISTRATEUR_REGIONAL
  ADMINISTRATEUR_LOCAL
  AGENT

  @@map("user_role")
}

enum StructureLevel {
  REGIONAL
  JURISDICTION
  SUB_JURISDICTION

  @@map("structure_level")
}

model Structure {
  id          String         @id @default(uuid()) @db.Uuid
  ssoCode     String         @unique @map("sso_code") @db.VarChar(100)
  displayName String         @map("display_name") @db.VarChar(255)
  level       StructureLevel
  parentId    String?        @map("parent_id") @db.Uuid
  isActive    Boolean        @default(true) @map("is_active")

  parent     Structure?  @relation("StructureHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   Structure[] @relation("StructureHierarchy")
  services   Service[]
  workUsers  User[]      @relation("UserWorkStructure")
  adminUsers User[]      @relation("UserAdminStructure")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([level])
  @@map("structures")
}

model Service {
  id          String  @id @default(uuid()) @db.Uuid
  structureId String  @map("structure_id") @db.Uuid
  slug        String  @db.VarChar(100)
  displayName String  @map("display_name") @db.VarChar(255)
  isActive    Boolean @default(true) @map("is_active")

  structure Structure  @relation(fields: [structureId], references: [id], onDelete: Restrict)
  documents Document[]
  users     User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([structureId, slug])
  @@map("services")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  serviceId       String         @map("service_id") @db.Uuid
  mailType        MailType       @map("mail_type")
  status          DocumentStatus @default(RECEIVED)
  createdByUserId String         @map("created_by_user_id") @db.Uuid

  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  files     DocumentFile[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdByUserId])
  @@index([serviceId, createdAt])
  @@index([status, createdAt])
  @@map("documents")
}

model DocumentFile {
  id             String           @id @default(uuid()) @db.Uuid
  documentId     String           @map("document_id") @db.Uuid
  kind           DocumentFileKind
  bucket         String           @db.VarChar(63)
  objectKey      String           @map("object_key") @db.VarChar(1024)
  filename       String           @db.VarChar(255)
  mimeType       String           @map("mime_type") @db.VarChar(127)
  sizeBytes      BigInt           @map("size_bytes")
  checksumSha256 String           @map("checksum_sha256") @db.Char(64)
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([bucket, objectKey])
  @@index([documentId, kind])
  @@map("document_files")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  igcidHash        String   @unique @map("igcid_hash") @db.Char(64)
  firstName        String   @map("first_name") @db.VarChar(100)
  lastName         String   @map("last_name") @db.VarChar(100)
  email            String   @db.VarChar(255)
  role             UserRole
  isActive         Boolean  @default(true) @map("is_active")
  workStructureId  String?  @map("work_structure_id") @db.Uuid
  adminStructureId String?  @map("admin_structure_id") @db.Uuid
  serviceId        String?  @map("service_id") @db.Uuid

  workStructure  Structure? @relation("UserWorkStructure", fields: [workStructureId], references: [id], onDelete: Restrict)
  adminStructure Structure? @relation("UserAdminStructure", fields: [adminStructureId], references: [id], onDelete: Restrict)
  service        Service?   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  documents      Document[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastLoginAt DateTime @default(now()) @map("last_login_at")

  @@index([workStructureId])
  @@index([adminStructureId])
  @@index([serviceId])
  @@index([role])
  @@map("users")
}
